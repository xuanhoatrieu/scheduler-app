PORT=5000
NODE_ENV=development
DATA_SOURCE=database
DB_URI=postgresql://your_db_user:your_db_password@localhost:5432/scheduler_db
ENCRYPTION_KEY=your_64_character_hex_encryption_key_here
JWT_SECRET=your_jwt_secret_key_here
ADMIN_SECRET_KEY=your_admin_secret_key_here

# NamViet Connect API
NAMVIET_API_URL=http://api.namvietjsc.edu.vn
NAMVIET_SECRET_KEY=your_namviet_secret_key_here
NAMVIET_MA_TRUONG=TUAF
NAMVIET_USERNAME=your_namviet_username

# SQL Server TUAF (Fallback / Direct Connection)
TUAF_DB_SERVER=your_sql_server_ip
TUAF_DB_USER=your_sql_server_user
TUAF_DB_PASSWORD=your_sql_server_password
TUAF_DB_NAME=ESS_TUAF_NEW_2
